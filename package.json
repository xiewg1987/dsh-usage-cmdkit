{
  "name": "dsh-usage-meters",
  "version": "0.2.0",
  "description": "DSH Web 本地插件：右侧栏用量遥测（Usage）。数据与配置全部留在本机。",
  "license": "MIT",
  "author": {
    "name": "xiewg1987",
    "url": "https://github.com/xiewg1987"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "src",
    "scripts",
    "docs",
    "!docs/hero",
    "cordis.patch.yml",
    "patch.dev.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiewg1987/dsh-usage-meters.git"
  },
  "homepage": "https://github.com/xiewg1987/dsh-usage-meters#readme",
  "bugs": {
    "url": "https://github.com/xiewg1987/dsh-usage-meters/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "usage",
    "token",
    "telemetry",
    "web",
    "sidebar",
    "dashboard",
    "meters"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.31",
    "esbuild": "0.28.1",
    "react": "^18.2.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  }
}
